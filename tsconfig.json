{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": "./src",
    "esModuleInterop": true,
    "jsx": "react",
    "lib": ["ESNext", "DOM"],
    "noImplicitAny": true,
    "outDir": "./dist/",
    "paths": {
      "authentication*": ["./authentication*"],
      "components": ["./components/index.js"],
      "context": ["./context/index.js"],
      "globals": ["./globals/index.js"],
      "services": ["./services/index.js"],
      "icons/*": ["./assets/icons/*"],
      "testUtils": ["../__test__/index.js"],
      "utils": ["./utils/index.js"]
    },
    "sourceMap": true,
    "target": "ES2017",
    "module": "es2022",
    "moduleResolution": "node",
  }
}