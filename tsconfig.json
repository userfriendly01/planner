
{
  "compilerOptions": {
    "allowJs": true,
    "baseUrl": "./src",
    "esModuleInterop": true,
    "jsx": "react",
    "lib": ["ESNext", "DOM"],
    "noImplicitAny": true,
    "outDir": "./dist/",
    "paths": {
      "alohaFlow*":[
         "./components/tabs/alohaFlow*"
      ],
      "alohaRouting*":[
         "./components/tabs/alohaRouting*"
      ],
      "authentication*":[
         "./authentication*"
      ],
      "callflowmanagement*":[
         "./components/tabs/callflowmanagement*"
      ],
      "components*":[
         "./components*",
         "./components/core*",
         "./components/core/ModalFetchingRing*"
      ],
      "context*":[
         "./context*"
      ],
      "dynamicFlow*":[
         "./components/tabs/dynamicFlow*"
      ],
      "globals*":[
         "./globals*",
         "./globals/interfaces*",
         "./globals/graphql*",
         "./globals/index*",
         "./globals/routes*",
         "./globals/styles*",
         "./globals/theme*"
      ],
      "icons*":[
         "./assets/icons*"
      ],
      "orgmanagement*":[
         "./components/tabs/orgmanagement*"
      ],
      "services*":[
         "./services*"
      ],
      "testUtils":[
         "../__test__/index.js"
      ],
      "usermanagement*":[
         "./components/tabs/usermanagement*",
         "./components/tabs/usermanagement/TritonUsersView/TritonUsersViewWrapper*"
      ],
      "utils*":[
         "./utils*"
      ]
   },
    "sourceMap": true,
    "target": "ES2017",
    "module": "es2022",
    "moduleResolution": "node",
  }
}